/* ==========================================================================
   设计语言：纸质账簿
   - 暖纸底 + 极细横线，像账本纸
   - 墨色做主调（按钮、导航），朱红只给支出，墨绿只给收入，颜色都有语义
   - 数字用衬线体 + 等宽数字，读金额更稳
   - 卡片靠细边线和极小投影，不靠大圆角和渐变
   ========================================================================== */

page {
  /* 色板 */
  --paper: #f5f1e8;
  --paper-deep: #efe9dc;
  --card: #fffdf8;
  --ink: #23201b;
  --ink-2: #6e6455;
  --ink-3: #a2957f;
  --line: #e6dece;
  --line-strong: #d8cdb8;

  --primary: #2b3a44;
  --primary-soft: #e7ecec;
  --expense: #b03a2e;
  --income: #2f6b4e;
  --warn: #a8761f;

  /* 兼容旧变量名，避免各页面引用失效 */
  --bg: var(--paper);
  --text: var(--ink);
  --text-2: var(--ink-2);
  --text-3: var(--ink-3);

  --serif: 'DIN Alternate', 'DIN Condensed', 'Roboto Condensed', 'Avenir Next Condensed',
    'Helvetica Neue', Arial, sans-serif;
  --font-song: 'Songti SC', 'STSong', 'Source Han Serif SC', 'Noto Serif CJK SC', 'SimSun',
    'STSongti-SC-Regular', serif;
  --radius: 16rpx;

  background-color: var(--paper);
  /* 纸张横线：很淡，只提供质感，不干扰阅读 */
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 63rpx,
    rgba(35, 32, 27, 0.035) 63rpx,
    rgba(35, 32, 27, 0.035) 64rpx
  );
  background-attachment: fixed;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

/* 页面容器 */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
}

.page-plain {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 卡片：纸片感，细边线 + 极浅投影 */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: 0 2rpx 0 rgba(35, 32, 27, 0.03);
}

.card + .card {
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.muted {
  color: var(--ink-2);
}

.hint {
  color: var(--ink-3);
  font-size: 24rpx;
}

/* 章节标题：宋体 + 字距，像账簿的分栏名 */
.section-title {
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 5rpx;
  margin: 36rpx 4rpx 14rpx;
  font-weight: 400;
}

.money-expense {
  color: var(--expense);
}

.money-income {
  color: var(--income);
}

/* 金额一律等宽数字（DIN 系字体会自动选中替代字形） */
.num {
  font-family: var(--serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  letter-spacing: 0;
}

/* 按钮：墨色实心，圆角收小，像盖章 */
.btn-primary {
  background: var(--primary);
  color: #fdfbf6;
  border-radius: 10rpx;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  line-height: inherit;
  font-family: inherit;
}

button::after {
  border: none;
}

/* 空状态 */
.empty {
  padding: 110rpx 40rpx;
  text-align: center;
  color: var(--ink-3);
}

.empty-emoji {
  display: block;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 22rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 8rpx;
  background: var(--paper);
  font-family: var(--font-song);
  font-size: 40rpx;
  color: var(--ink-3);
  line-height: 88rpx;
  text-align: center;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* 细分隔线，账页常用元素 */
.rule {
  height: 1rpx;
  background: var(--line);
}
