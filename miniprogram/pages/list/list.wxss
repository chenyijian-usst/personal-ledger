.setup-btn {
  width: 360rpx;
  margin: 32rpx auto 0;
}

/* 月份切换：去掉圆形按钮，用轻量箭头 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 18rpx;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--ink-3);
}

.month-pick {
  min-width: 260rpx;
  text-align: center;
  font-family: var(--font-song);
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.month-caret {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-left: 8rpx;
}

/* 汇总：三栏 + 竖细线 */
.summary {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 6rpx;
  padding: 22rpx 0;
  box-shadow: 0 3rpx 0 rgba(35, 32, 27, 0.04);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-item + .summary-item {
  border-left: 1rpx solid var(--line);
}

.summary-label {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.summary-value {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

/* 日期分组头 */
.group-head {
  display: flex;
  align-items: baseline;
  padding: 30rpx 4rpx 10rpx;
}

.group-day {
  font-family: var(--font-song);
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.group-weekday {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-left: 8rpx;
}

.group-summary {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 分组列表 */
.group-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 0 26rpx;
}

.record {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.record:last-child {
  border-bottom: none;
}

/* 方形图章式分类图标 */
.record-icon {
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 8rpx;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 28rpx;
}

.record-remark {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  font-size: 31rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tip {
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  padding: 32rpx 0 8rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  padding: 0 34rpx;
  border-radius: 10rpx;
  background: var(--primary);
  color: #fdfbf6;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(35, 32, 27, 0.22);
  z-index: 20;
}

.fab-plus {
  font-size: 34rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.fab-text {
  font-size: 27rpx;
  letter-spacing: 1rpx;
}
