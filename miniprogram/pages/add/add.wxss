.add-page {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* 收支切换：下划线标签，和统计页一致 */
.type-switch {
  display: flex;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 20rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  height: 70rpx;
  line-height: 70rpx;
  font-family: var(--font-song);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
  position: relative;
}

.type-item.active {
  font-weight: 600;
}

.type-item.active.expense {
  color: var(--expense);
}

.type-item.active.income {
  color: var(--income);
}

.type-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -1rpx;
  width: 56rpx;
  height: 3rpx;
  background: currentColor;
}

/* 分类：方形图章 */
.cat-card {
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--card);
  padding: 20rpx 10rpx 8rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 18rpx;
}

.cat-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  transition: all 0.15s;
}

.cat-item.active .cat-icon {
  border-color: var(--ink);
  background: var(--card);
  box-shadow: 0 2rpx 0 var(--line-strong);
  transform: translateY(-2rpx);
}

.cat-name {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

.cat-item.active .cat-name {
  color: var(--ink);
  font-weight: 500;
}

.cat-loading {
  text-align: center;
  color: var(--ink-3);
  padding: 40rpx;
}

/* 表单 */
.form-card {
  padding: 0 26rpx;
  margin-top: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx dashed var(--line);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 96rpx;
  font-size: 26rpx;
  color: var(--ink-3);
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.form-input {
  flex: 1;
  font-size: 27rpx;
}

.form-placeholder {
  color: var(--ink-3);
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
}

.form-arrow {
  color: var(--ink-3);
}

/* 底部金额与按钮 */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line);
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  z-index: 30;
}

.amount-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 6rpx 14rpx;
}

.amount-label {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--ink-3);
}

.amount-value {
  display: flex;
  align-items: baseline;
}

.amount-currency {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-right: 6rpx;
}

.amount-num {
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -1rpx;
}

.amount-num.placeholder {
  color: var(--ink-3);
  font-weight: 400;
}

.bottom-actions {
  display: flex;
}

.again-btn {
  width: 210rpx;
  flex-shrink: 0;
  height: 92rpx;
  line-height: 92rpx;
  margin-right: 16rpx;
}

.save-btn {
  flex: 1;
}

.btn-primary[disabled],
.btn-ghost[disabled] {
  opacity: 0.4;
}

/* 键盘 */
.keypad-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(35, 32, 27, 0.3);
  z-index: 40;
}

.keypad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--paper);
  border-top: 1rpx solid var(--line-strong);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.keypad-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 30rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--line);
}

.keypad-amount {
  font-family: var(--serif);
  font-variant-numeric: tabular-nums;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.keypad-done {
  color: var(--ink);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  padding: 8rpx 14rpx;
  border-bottom: 2rpx solid var(--ink);
}

.keypad-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 14rpx;
}

.key {
  width: calc(25% - 12rpx);
  margin: 6rpx;
  height: 104rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--serif);
  font-size: 40rpx;
  color: var(--ink);
}

.key:active {
  background: var(--paper-deep);
}

.key.fn {
  background: var(--paper-deep);
  color: var(--ink-2);
  font-size: 30rpx;
  font-family: inherit;
}

.key.zero {
  width: calc(50% - 12rpx);
}

.key.ok {
  width: calc(50% - 12rpx);
  background: var(--primary);
  border-color: var(--primary);
  color: #fdfbf6;
  font-family: inherit;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
