.setup-btn {
  width: 360rpx;
  margin: 32rpx auto 0;
}

.head {
  padding: 16rpx 8rpx 28rpx;
}

.head-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

/* 说明 */
.how-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.how-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.how-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
  line-height: 1.6;
}

.how-tag.wechat {
  color: #1fa971;
  background: #e8f7f0;
}

.how-tag.alipay {
  color: #1677ff;
  background: #e9f1ff;
}

.how-text {
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.how-tip {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-3);
  background: var(--paper);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.big-btn {
  width: 100%;
  margin-top: 28rpx;
}

.or {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 20rpx 0 0;
}

.paste-card {
  margin-top: 24rpx;
}

.paste-area {
  width: 100%;
  min-height: 240rpx;
  font-size: 24rpx;
  line-height: 1.6;
  background: var(--paper);
  border-radius: 12rpx;
  padding: 20rpx;
}

.paste-placeholder {
  color: var(--text-3);
}

.paste-btn {
  margin-top: 20rpx;
}

/* 解析结果 */
.result-file {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.result-source {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.result-stats {
  display: flex;
  margin: 24rpx 0 16rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* 预览 */
.preview-card {
  padding: 8rpx 28rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-left {
  flex: 1;
  min-width: 0;
}

.preview-date {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
}

.preview-remark {
  display: block;
  font-size: 27rpx;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.preview-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.preview-hint {
  display: block;
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.preview-more {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 20rpx 0;
}

/* 底部按钮 */
.actions {
  display: flex;
  margin-top: 32rpx;
}

.again {
  width: 200rpx;
  height: 92rpx;
  line-height: 92rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.do-import {
  flex: 1;
}
