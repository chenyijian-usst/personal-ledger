.head {
  padding: 24rpx 8rpx 32rpx;
}

.head-emoji {
  font-size: 64rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.env-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.env-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 6rpx;
  word-break: break-all;
}

.env-copy {
  width: 140rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.step {
  margin-bottom: 20rpx;
}

.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  line-height: 40rpx;
  margin-right: 12rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
}

.step-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.step-code {
  margin-top: 14rpx;
  background: #f6f8fb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  color: #4a5568;
  font-family: 'SFMono-Regular', Consolas, monospace;
  word-break: break-all;
}

.notice {
  background: #fff8e6;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.7;
  margin-top: 8rpx;
}

.recheck {
  width: 100%;
  margin-top: 32rpx;
}
