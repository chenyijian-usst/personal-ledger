<view class="page">
  <!-- 没配置云开发时，先引导 -->
  <view wx:if="{{!ready}}" class="card setup-card">
    <view class="setup-emoji">未</view>
    <view class="setup-title">还差一步就能用了</view>
    <view class="setup-desc">小程序还没连上云开发环境。点下面看 3 分钟的配置说明。</view>
    <button class="btn-primary setup-btn" bindtap="goSetup">查看配置说明</button>
  </view>

  <block wx:else>
    <!-- 演示模式提示 -->
    <view wx:if="{{localMode}}" class="notice-bar" bindtap="goSetup">
      <text class="notice-tag">演示</text>
      <text class="notice-text">数据只存在这台设备上，点这里换成云开发</text>
    </view>

    <!-- 连不上云开发时的提示 -->
    <view wx:if="{{errorMsg}}" class="error-card" bindtap="goSetup">
      <text class="error-title">连不上云开发</text>
      <text class="error-msg">{{errorMsg}}</text>
      <text class="error-action">点这里看怎么修 ›</text>
    </view>

    <!-- 账页头部 -->
    <view class="ledger">
      <view class="ledger-top">
        <text class="ledger-month">{{monthText}}</text>
        <text class="ledger-count">{{count}} 笔</text>
      </view>

      <text class="ledger-label">结余</text>
      <view class="ledger-balance num {{balanceNegative ? 'neg' : ''}}">{{balance}}</view>

      <view class="ledger-rule"></view>

      <view class="ledger-cells">
        <view class="ledger-cell">
          <text class="cell-k">支出</text>
          <text class="cell-v num">{{expense}}</text>
        </view>
        <view class="ledger-cell">
          <text class="cell-k">收入</text>
          <text class="cell-v num">{{income}}</text>
        </view>
      </view>
    </view>

    <!-- 预算 -->
    <view wx:if="{{hasBudget}}" class="budget" bindtap="goBudget">
      <view class="row-between">
        <text class="budget-k">本月预算</text>
        <text class="budget-v num {{budgetOver ? 'over' : ''}}">{{budgetLeftText}}</text>
      </view>
      <view class="budget-track">
        <view class="budget-fill {{budgetOver ? 'over' : ''}}" style="width: {{budgetPercent}}%"></view>
        <view class="budget-tick" wx:for="{{ticks}}" wx:key="*this" style="left: {{item}}%"></view>
      </view>
      <view class="row-between budget-foot">
        <text class="tiny">已用 {{budgetUsed}}</text>
        <text class="tiny">额度 {{budgetAmount}}</text>
      </view>
    </view>

    <view wx:else class="budget-empty" bindtap="goBudget">
      <text class="budget-empty-icon">◎</text>
      <view class="col budget-empty-main">
        <text class="budget-empty-t">还没设本月预算</text>
        <text class="tiny">设个额度，超支时会提醒你</text>
      </view>
      <text class="budget-empty-arrow">›</text>
    </view>

    <!-- 最近记录 -->
    <view class="row-between sec-head">
      <text class="section-title">最近</text>
      <text class="sec-more" bindtap="goList">全部 ›</text>
    </view>

    <view wx:if="{{recent.length}}" class="entry-list">
      <view
        wx:for="{{recent}}"
        wx:key="id"
        class="entry"
        data-id="{{item.id}}"
        bindtap="onRecordTap"
      >
        <view class="entry-dot {{item.isIncome ? 'inc' : 'exp'}}"></view>
        <view class="entry-main">
          <view class="entry-name">{{item.name}}</view>
          <view wx:if="{{item.remark}}" class="entry-remark">{{item.remark}}</view>
        </view>
        <view class="entry-right">
          <text class="entry-amount num {{item.isIncome ? 'inc' : 'exp'}}">{{item.amountText}}</text>
          <text class="entry-date">{{item.dateText}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty">
      <text class="empty-emoji">▤</text>
      <view>本月还没有记账</view>
      <view class="hint">点右下角「记一笔」开始</view>
    </view>

    <!-- 悬浮按钮 -->
    <view class="fab" bindtap="goAdd">
      <text class="fab-plus">＋</text>
      <text class="fab-text">记一笔</text>
    </view>
  </block>
</view>
