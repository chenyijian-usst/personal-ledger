<view class="page">
  <!-- 没配置云开发时，先引导 -->
  <view wx:if="{{!ready}}" class="card setup-card">
    <view class="setup-emoji">🔧</view>
    <view class="setup-title">还差一步就能用了</view>
    <view class="setup-desc">小程序还没连上云开发环境。点下面看 3 分钟的配置说明。</view>
    <button class="btn-primary setup-btn" bindtap="goSetup">查看配置说明</button>
  </view>

  <block wx:else>
    <!-- 本月概览 -->
    <view class="hero">
      <view class="hero-head">
        <text class="hero-month">{{monthText}}</text>
        <text class="hero-label">结余</text>
      </view>
      <view class="hero-amount num {{balanceNegative ? 'money-expense' : ''}}">{{balance}}</view>
      <view class="hero-row">
        <view class="hero-item">
          <text class="hero-item-label">支出</text>
          <text class="hero-item-value num">{{expense}}</text>
        </view>
        <view class="hero-divider"></view>
        <view class="hero-item">
          <text class="hero-item-label">收入</text>
          <text class="hero-item-value num">{{income}}</text>
        </view>
      </view>
    </view>

    <!-- 预算进度 -->
    <view wx:if="{{hasBudget}}" class="card budget-card" bindtap="goBudget">
      <view class="row-between">
        <text class="budget-title">本月预算</text>
        <text class="budget-left {{budgetOver ? 'over' : ''}}">{{budgetLeftText}}</text>
      </view>
      <view class="progress">
        <view class="progress-inner {{budgetOver ? 'over' : ''}}" style="width: {{budgetPercent}}%"></view>
      </view>
      <view class="row-between budget-foot">
        <text class="hint">已用 {{budgetUsed}}</text>
        <text class="hint">预算 {{budgetAmount}}</text>
      </view>
    </view>

    <view wx:else class="card budget-empty" bindtap="goBudget">
      <text class="budget-empty-emoji">🎯</text>
      <view class="col">
        <text class="budget-empty-title">还没设置本月预算</text>
        <text class="hint">设一个额度，超支时提醒你</text>
      </view>
      <text class="budget-empty-arrow">›</text>
    </view>

    <!-- 最近记录 -->
    <view class="row-between section-head">
      <text class="section-title">最近记录</text>
      <text class="section-more" bindtap="goList">全部 ›</text>
    </view>

    <view wx:if="{{recent.length}}" class="card list-card">
      <view
        wx:for="{{recent}}"
        wx:key="id"
        class="record"
        data-id="{{item.id}}"
        bindtap="onRecordTap"
      >
        <view class="record-icon">{{item.icon}}</view>
        <view class="record-main">
          <view class="record-name">{{item.name}}</view>
          <view wx:if="{{item.remark}}" class="record-remark">{{item.remark}}</view>
        </view>
        <view class="record-right">
          <text class="record-amount num {{item.isIncome ? 'money-income' : 'money-expense'}}">{{item.amountText}}</text>
          <text class="record-date">{{item.dateText}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty">
      <text class="empty-emoji">🧾</text>
      <view>本月还没有记账</view>
      <view class="hint">点右下角「记一笔」开始</view>
    </view>

    <!-- 悬浮按钮 -->
    <view class="fab" bindtap="goAdd">
      <text class="fab-plus">＋</text>
      <text class="fab-text">记一笔</text>
    </view>
  </block>
</view>
