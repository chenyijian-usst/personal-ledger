.setup-card {
  margin-top: 120rpx;
  text-align: center;
  padding: 56rpx 40rpx;
}

.setup-emoji {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--paper);
  font-family: var(--font-song);
  font-size: 44rpx;
  color: var(--ink-3);
  line-height: 96rpx;
  text-align: center;
}

.setup-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.setup-desc {
  color: var(--ink-2);
  margin-bottom: 40rpx;
}

.setup-btn {
  width: 100%;
}

/* 顶部提示条 */
.notice-bar {
  display: flex;
  align-items: center;
  background: #fdf6e3;
  border: 1rpx solid #eadfc2;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 20rpx;
}

.notice-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #8a6a1f;
  border: 1rpx solid #d9c48c;
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-right: 14rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #8a6a1f;
}

/* 连不上云开发 */
.error-card {
  background: #fdf0ee;
  border: 1rpx solid #eccfc9;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.error-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--expense);
}

.error-msg {
  font-size: 22rpx;
  color: #8c3a30;
  margin-top: 8rpx;
  line-height: 1.6;
}

.error-action {
  font-size: 22rpx;
  color: var(--expense);
  margin-top: 10rpx;
}

/* ============ 账页头部 ============ */
.ledger {
  position: relative;
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 6rpx;
  padding: 26rpx 30rpx 24rpx;
  box-shadow: 0 3rpx 0 rgba(35, 32, 27, 0.04);
}

/* 左侧书脊阴影，暗示这是一页纸 */
.ledger::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(90deg, rgba(35, 32, 27, 0.06), transparent);
  border-radius: 6rpx 0 0 6rpx;
}

.ledger-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ledger-month {
  font-family: var(--font-song);
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--ink-3);
}

.ledger-count {
  font-size: 22rpx;
  color: var(--ink-3);
}

.ledger-label {
  display: block;
  font-family: var(--font-song);
  font-size: 23rpx;
  letter-spacing: 5rpx;
  color: var(--ink-3);
  margin-top: 22rpx;
}

.ledger-balance {
  font-size: 84rpx;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin-top: 2rpx;
}

.ledger-balance.neg {
  color: var(--expense);
}

.ledger-rule {
  height: 1rpx;
  background: var(--line);
  margin: 22rpx 0 18rpx;
}

.ledger-cells {
  display: flex;
}

.ledger-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ledger-cell + .ledger-cell {
  border-left: 1rpx solid var(--line);
  padding-left: 26rpx;
}

.cell-k {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.cell-v {
  font-size: 34rpx;
  margin-top: 4rpx;
  color: var(--expense);
}

.ledger-cell + .ledger-cell .cell-v {
  color: var(--income);
}

/* ============ 预算 ============ */
.budget {
  margin-top: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 24rpx 28rpx 20rpx;
}

.budget-k {
  font-family: var(--font-song);
  font-size: 25rpx;
  color: var(--ink-2);
  letter-spacing: 3rpx;
}

.budget-v {
  font-size: 26rpx;
  color: var(--ink-2);
}

.budget-v.over {
  color: var(--expense);
}

.budget-track {
  position: relative;
  height: 10rpx;
  background: var(--paper-deep);
  border-radius: 2rpx;
  margin: 18rpx 0 12rpx;
  overflow: visible;
}

.budget-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 2rpx;
  transition: width 0.35s ease;
}

.budget-fill.over {
  background: var(--expense);
}

/* 刻度：25% / 50% / 75% */
.budget-tick {
  position: absolute;
  top: -3rpx;
  width: 1rpx;
  height: 16rpx;
  background: rgba(35, 32, 27, 0.12);
}

.tiny {
  font-size: 21rpx;
  color: var(--ink-3);
}

.budget-foot {
  margin-top: 2rpx;
}

.budget-empty {
  margin-top: 20rpx;
  background: var(--card);
  border: 1rpx dashed var(--line-strong);
  border-radius: var(--radius);
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
}

.budget-empty-icon {
  font-size: 34rpx;
  color: var(--ink-3);
  margin-right: 18rpx;
}

.budget-empty-main {
  flex: 1;
}

.budget-empty-t {
  font-size: 26rpx;
  color: var(--ink);
  margin-bottom: 2rpx;
}

.budget-empty-arrow {
  color: var(--ink-3);
  font-size: 34rpx;
  margin-left: 12rpx;
}

/* ============ 最近记录 ============ */
.sec-head {
  margin: 34rpx 4rpx 0;
}

.sec-head .section-title {
  margin: 0;
}

.sec-more {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.entry-list {
  margin-top: 10rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 0 26rpx;
}

.entry {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.entry:last-child {
  border-bottom: none;
}

/* 行内不放图标：收支靠金额前的 -/+ 与朱红/墨绿 */
.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-name {
  font-size: 28rpx;
  color: var(--ink);
}

.entry-remark {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.entry-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.entry-amount.exp {
  color: var(--expense);
}

.entry-amount.inc {
  color: var(--income);
}

.entry-date {
  display: block;
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  padding: 0 34rpx;
  border-radius: 10rpx;
  background: var(--primary);
  color: #fdfbf6;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(35, 32, 27, 0.22);
  z-index: 20;
}

.fab-plus {
  font-size: 34rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.fab-text {
  font-size: 27rpx;
  letter-spacing: 1rpx;
}
