.setup-card {
  margin-top: 120rpx;
  text-align: center;
  padding: 56rpx 40rpx;
}

.setup-emoji {
  font-size: 88rpx;
}

.setup-title {
  font-size: 36rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.setup-desc {
  color: var(--text-2);
  margin-bottom: 40rpx;
}

.setup-btn {
  width: 100%;
}

/* 连不上云开发的提示 */
.error-card {
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.error-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #cf1322;
}

.error-msg {
  font-size: 23rpx;
  color: #a8071a;
  margin-top: 8rpx;
  line-height: 1.6;
}

.error-action {
  font-size: 22rpx;
  color: #cf1322;
  margin-top: 10rpx;
}

/* 演示模式横幅 */
.demo-banner {
  display: flex;
  align-items: center;
  background: #fff7e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.demo-tag {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #b26a00;
  background: #ffe7ba;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
}

.demo-text {
  font-size: 23rpx;
  color: #8a6d3b;
}

/* 顶部结余卡 */
.hero {
  background: linear-gradient(135deg, #3a6ff7 0%, #5b8cff 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(58, 111, 247, 0.25);
}

.hero-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero-month {
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero-amount {
  font-size: 76rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  margin: 8rpx 0 4rpx;
  line-height: 1.2;
}

.hero-amount.money-expense {
  color: #ffe0dd;
}

.hero-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.hero-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-item-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.hero-item-value {
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.hero-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 0 24rpx;
}

/* 预算 */
.budget-card {
  margin-top: 24rpx;
}

.budget-title {
  font-size: 28rpx;
  font-weight: 500;
}

.budget-left {
  font-size: 26rpx;
  color: var(--text-2);
}

.budget-left.over {
  color: var(--expense);
  font-weight: 600;
}

.progress {
  height: 16rpx;
  background: #eef1f6;
  border-radius: 999rpx;
  margin: 20rpx 0 12rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5b8cff, #3a6ff7);
  transition: width 0.3s ease;
}

.progress-inner.over {
  background: linear-gradient(90deg, #ff8a80, #f2544b);
}

.budget-foot {
  margin-top: 4rpx;
}

.budget-empty {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
}

.budget-empty-emoji {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.budget-empty-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.budget-empty-arrow {
  margin-left: auto;
  color: var(--text-3);
  font-size: 40rpx;
}

/* 记录列表 */
.section-head {
  margin: 36rpx 8rpx 4rpx;
}

.section-head .section-title {
  margin: 0;
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

.list-card {
  padding: 8rpx 28rpx;
  margin-top: 12rpx;
}

.record {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.record:last-child {
  border-bottom: none;
}

.record-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f4f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 29rpx;
  font-weight: 500;
}

.record-remark {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.record-date {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* 悬浮记一笔 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(58, 111, 247, 0.35);
  z-index: 20;
}

.fab-plus {
  font-size: 40rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
}
