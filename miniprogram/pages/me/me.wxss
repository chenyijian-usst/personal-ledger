/* 数据自检卡 */
.data-card {
  margin-bottom: 24rpx;
}

.data-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.data-mode {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
}

.mode-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: var(--income);
}

.mode-dot.local {
  background: var(--warn);
}

.data-desc {
  margin-top: 6rpx;
  line-height: 1.6;
}

.data-count {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.data-num {
  font-size: 44rpx;
  font-weight: 600;
}

.data-unit {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 4rpx;
}

.data-range {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--text-3);
}

.profile {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 40rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.05);
}

.profile-title {
  font-family: var(--font-song);
  font-size: 38rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  margin-bottom: 6rpx;
}

.menu {
  padding: 4rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 6rpx;
  background: var(--paper);
  font-family: var(--font-song);
  font-size: 25rpx;
  color: var(--ink-2);
  text-align: center;
  line-height: 50rpx;
  flex-shrink: 0;
}

.menu-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-label {
  font-size: 29rpx;
  font-weight: 500;
}

.menu-desc {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.menu-arrow {
  color: var(--text-3);
  font-size: 36rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 16rpx;
}

.footer .hint + .hint {
  margin-top: 8rpx;
}
