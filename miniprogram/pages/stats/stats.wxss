.setup-btn {
  width: 360rpx;
  margin: 32rpx auto 0;
}

/* 月份 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 16rpx;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--ink-3);
}

.month-pick {
  min-width: 260rpx;
  text-align: center;
  font-family: var(--font-song);
  font-size: 31rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* 收支切换：改成下划线标签，像账簿的收支两栏 */
.type-switch {
  display: flex;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 24rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  height: 66rpx;
  line-height: 66rpx;
  font-family: var(--font-song);
  font-size: 27rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
  position: relative;
}

.type-item.active {
  color: var(--ink);
  font-weight: 600;
}

.type-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -1rpx;
  width: 56rpx;
  height: 3rpx;
  background: var(--ink);
}

/* 合计 */
.total-card {
  background: var(--card);
  border: 1rpx solid var(--line-strong);
  border-radius: 6rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 3rpx 0 rgba(35, 32, 27, 0.04);
}

.total-label {
  font-family: var(--font-song);
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: var(--ink-3);
}

.total-value {
  font-size: 72rpx;
  line-height: 1.15;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin: 6rpx 0 4rpx;
  color: var(--expense);
}

.total-value.money-income {
  color: var(--income);
}

.total-count {
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 分类占比 */
.ratio-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 6rpx 26rpx;
}

.ratio {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.ratio:last-child {
  border-bottom: none;
}

.ratio-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.ratio-name {
  display: flex;
  align-items: center;
  font-size: 27rpx;
}

.ratio-icon {
  width: 34rpx;
  text-align: center;
  font-family: var(--font-song);
  font-size: 26rpx;
  color: var(--ink-2);
  margin-right: 10rpx;
}

.ratio-count {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-left: 10rpx;
}

.ratio-amount {
  display: flex;
  align-items: baseline;
  font-size: 27rpx;
  font-weight: 600;
}

.ratio-percent {
  font-size: 20rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-left: 10rpx;
  width: 66rpx;
  text-align: right;
}

.ratio-track {
  height: 6rpx;
  background: var(--paper-deep);
  border-radius: 1rpx;
  overflow: hidden;
}

.ratio-fill {
  height: 100%;
  border-radius: 1rpx;
  min-width: 4rpx;
  transition: width 0.3s ease;
}

/* 趋势 */
.trend-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 26rpx 14rpx 18rpx;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  border-bottom: 1rpx solid var(--line-strong);
  padding-bottom: 0;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-value {
  font-size: 18rpx;
  color: var(--ink-3);
  margin-bottom: 6rpx;
  transform: scale(0.94);
}

.trend-bar-wrap {
  height: 200rpx;
  width: 26rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.trend-bar {
  width: 100%;
  background: var(--line-strong);
  border-radius: 1rpx 1rpx 0 0;
}

.trend-bar.current {
  background: var(--primary);
}

.trend-label {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}

.trend-label.current {
  color: var(--ink);
  font-weight: 600;
}
